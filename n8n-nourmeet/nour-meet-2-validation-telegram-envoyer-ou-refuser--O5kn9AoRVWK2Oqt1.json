      "name": "Lire le clic",
      "parameters": {
        "jsCode": "// ====== À REMPLIR UNE FOIS ======\nconst CONFIG = {\n  TELEGRAM_CHAT_ID: '6339897621',           // identifiant Telegram de la personne qui valide (via @userinfobot)\n  EXPEDITEUR: 'Nūr Meet <contact@nourmeet.com>',\n  SIGNATAIRE: 'Walid',\n  LIEN_CANDIDATURE: 'https://nourmeet.com/login',\n  SITE_WEB: 'https://nourmeet.com',         // lien du logo en bas du mail\n  LOGO_URL: 'https://n8n.nourmeet.com/webhook/logo-nour-meet', // logo servi par le workflow 5 (vide = lien texte seul)\n  PROPOSITIONS_PAR_JOUR: 50,\n  RELANCE_1_APRES_JOURS: 4,                 // J+4 (à confirmer)\n  RELANCE_2_APRES_JOURS: 9,                 // J+9 (à confirmer)\n};\n\nconst cq = $json.callback_query || {};\nconst [action, id] = String(cq.data || '').split(':');\nreturn { json: {\n  ...CONFIG,\n  autorise: String(cq.from?.id) === String(CONFIG.TELEGRAM_CHAT_ID) && ['S', 'R'].includes(action) && !!id,\n  action, envoi_id: Number(id), query_id: cq.id,\n  chat_id: cq.message?.chat?.id, message_id: cq.message?.message_id, texte: cq.message?.text || '',\n}};"
      },

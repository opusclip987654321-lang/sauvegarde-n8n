    {
      "id": "de1f40c2-c68b-41ee-bcc8-75dbde76a848",
      "name": "Préparer la version avec logo",
      "parameters": {
        "jsCode": "const C = $('Lire le clic').first().json;\nconst e = $json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst fmt = (t) => esc(t).replace(/(https?:\\/\\/[^\\s<]+)/g, '<a href=\"$1\">$1</a>').replace(/\\n/g, '<br>');\n// Le logo se place juste après la signature, avant la ligne « STOP »\nconst i = String(e.corps).lastIndexOf('\\n\\nSi vous ne souhaitez plus');\nconst avant = i >= 0 ? String(e.corps).slice(0, i) : String(e.corps);\nconst stop = i >= 0 ? String(e.corps).slice(i + 2) : '';\nconst site = esc(C.SITE_WEB);\nconst logo = C.LOGO_URL\n  ? `<a href=\"${site}\"><img src=\"${esc(C.LOGO_URL)}\" alt=\"Nūr Meet\" width=\"140\" style=\"border:0;display:block;margin-top:16px\"></a>`\n  : '';\nconst html = `<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#222\">${fmt(avant)}${logo}<p style=\"margin-top:8px\"><a href=\"${site}\">${site.replace(/^https?:\\/\\//, '')}</a></p>${stop ? `<p style=\"font-size:12px;color:#777\">${fmt(stop)}</p>` : ''}</div>`;\nreturn [{ json: { ...e, html } }];"
      },

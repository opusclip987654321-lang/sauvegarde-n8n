    {
      "id": "8b2a4c52-b419-458b-a6d4-653215b65250",
      "name": "ANALYSER MESSAGE",
      "parameters": {
        "jsCode": "const input=$input.first().json;\nconst msg=input.message||{};\nconst raw=String(msg.text||'').trim();\nconst chatId=msg.chat?.id;\nconst userId=msg.from?.id;\nif(!raw||chatId===undefined||userId===undefined)return [];\n\nconst store=$getWorkflowStaticData('global');\nconst CLAIM_CODE='X2VF3EJ19C';\nconst norm=s=>String(s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().trim();\nconst html=s=>String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst cleaned=raw.replace(/^\\/([a-zA-Z_]+)@\\w+/,'/$1').trim();\nconst low=norm(cleaned);\n\nif(!store.telegram_owner_user_id){\n if(low==='/claim '+CLAIM_CODE.toLowerCase()){\n  store.telegram_owner_user_id=String(userId);\n  store.telegram_chat_id=String(chatId);\n  return [{json:{route:'config',chat_id:String(chatId),\n   cle_unique:'_config_telegram',statut:'CONFIG',\n   informations_a_verifier:String(chatId),\n   derniere_mise_a_jour:new Date().toISOString(),\n   telegram_message:'✅ Bot Impacteur associé à ce compte.\\n\\nLes fiches prêtes arriveront ici automatiquement.\\nEnvoie /aide pour voir les commandes.'}}];\n }\n return [{json:{route:'reply',chat_id:String(chatId),\n  telegram_message:'🔒 Bot non associé. Utilise la commande /claim fournie lors de l’installation.'}}];\n}\nif(String(userId)!==String(store.telegram_owner_user_id))return [];\nstore.telegram_chat_id=String(chatId);\n\nconst help=`Commandes :\n\nValidation des fiches prêtes (reçues ici automatiquement) :\n/valider CLE — approuve avec l’email proposé et crée le brouillon Gmail immédiatement\n/email CLE adresse@retiree.invalid — approuve avec cette adresse\n/rejeter CLE — écarte la fiche\n\n/rapport — état de la prospection\n/aide — ce message\n\nDécouvertes automatiques : livres (workflow A, 8h07) et YouTube (workflow B, 12h07), en alternance de chaîne. Lancement manuel possible dans n8n.\nAucun email n’est envoyé automatiquement : uniquement des brouillons Gmail après TA validation.`;\n\nif(['/start','/aide','aide','menu','commandes'].includes(low)){\n return [{json:{route:'reply',chat_id:String(chatId),telegram_message:help}}];\n}\nif(low==='/id'||low==='id'){\n return [{json:{route:'reply',chat_id:String(chatId),\n  telegram_message:'User ID : '+html(userId)+'\\nChat ID : '+html(chatId)}}];\n}\n\nlet v=cleaned.match(/^\\/valider\\s+(\\S+)$/i);\nif(v)return [{json:{route:'validation',action:'valider',chat_id:String(chatId),cle_unique:v[1].trim()}}];\nv=cleaned.match(/^\\/rejeter\\s+(\\S+)$/i);\nif(v)return [{json:{route:'validation',action:'rejeter',chat_id:String(chatId),cle_unique:v[1].trim()}}];\nv=cleaned.match(/^\\/email\\s+(\\S+)\\s+(\\S+@\\S+\\.\\S+)$/i);\nif(v)return [{json:{route:'validation',action:'email',chat_id:String(chatId),cle_unique:v[1].trim(),email:v[2].trim().toLowerCase()}}];\nif(/^\\/(valider|rejeter|email)\\b/i.test(cleaned)){\n return [{json:{route:'reply',chat_id:String(chatId),\n  telegram_message:'Usage :\\n/valider CLE\\n/email CLE adresse@retiree.invalid\\n/rejeter CLE\\n\\nLa CLE figure dans le message « Fiche prête ».'}}];\n}\nif(low==='/rapport'||/\\b(rapport|bilan)\\b/.test(low)){\n return [{json:{route:'info',chat_id:String(chatId)}}];\n}\nreturn [{json:{route:'reply',chat_id:String(chatId),\n telegram_message:'Commande non reconnue. Envoie /aide pour la liste.'}}];"
      },
      "position": [
        -400,
        128
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2

    {
      "id": "c89618ab-00a6-4c63-964b-fa8fcf9f3815",
      "name": "RAPPORT",
      "parameters": {
        "jsCode": "const req=$('ANALYSER MESSAGE').first().json;\nconst lignes=$input.all().map(i=>i.json).filter(r=>String(r.cle_unique||'')!=='_config_telegram');\nconst html=s=>String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst compte={};\nfor(const r of lignes){const s=String(r.statut||'VIDE').trim().toUpperCase();compte[s]=(compte[s]||0)+1;}\nconst l=['📊 <b>Prospection</b> — '+lignes.length+' fiches'];\nfor(const [s,c] of Object.entries(compte).sort((a,b)=>b[1]-a[1]))l.push('• '+s+' : '+c);\nconst attente=lignes.filter(r=>String(r.statut||'').toUpperCase()==='A_VERIFIER'&&String(r.message_auteur||'').trim());\nif(attente.length){\n l.push('','⏳ <b>En attente de validation :</b>');\n for(const r of attente.slice(0,5)){\n  l.push('👤 '+html(r.auteur)+' — /valider '+String(r.cle_unique||''));\n }\n if(attente.length>5)l.push('… et '+(attente.length-5)+' autres.');\n}\nreturn [{json:{chat_id:String(req.chat_id||''),telegram_message:l.join('\\n')}}];"
      },
      "position": [
        208,
        432
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2

    {
      "id": "abfcaa87-be4f-43d3-90c8-0a1c91ff5dbb",
      "name": "PREPARER VALIDATION",
      "parameters": {
        "jsCode": "// V20 : traite /valider, /email, /rejeter sur une fiche prête.\nconst req=$('ANALYSER MESSAGE').first().json;\nconst cle=String(req.cle_unique||'').trim();\nconst action=String(req.action||'');\nconst chat_id=String(req.chat_id||'');\nconst rows=$input.all().map(i=>i.json);\nconst row=rows.find(r=>String(r.cle_unique||'').trim()===cle);\nif(!row){\n  return [{json:{ok:false,action,chat_id,telegram_message:'❌ Aucune fiche trouvée pour '+cle+'.'}}];\n}\nconst publicDomains=new Set(['gmail.com','hotmail.com','outlook.com','yahoo.com','proton.me','icloud.com','live.com']);\nlet candidats=[];try{candidats=JSON.parse(String(row.emails_candidats||'[]'));}catch(e){candidats=[];}\nif(!Array.isArray(candidats))candidats=[];\n\nif(action==='rejeter'){\n  return [{json:{...row,ok:true,action,chat_id,\n    statut:'REJETE_MANUEL',validation_contact:'NON',\n    derniere_mise_a_jour:new Date().toISOString(),\n    telegram_message:'🗑 Fiche '+cle+' rejetée ('+String(row.auteur||'')+'). Aucun brouillon ne sera créé. L’auteur reste prospectable pour un autre livre.'}}];\n}\n\nif(String(row.draft_id||'').trim()){\n  return [{json:{ok:false,action,chat_id,telegram_message:'ℹ️ Un brouillon Gmail existe déjà pour '+cle+' ('+String(row.auteur||'')+').'}}];\n}\nif(!String(row.message_auteur||'').trim()||!String(row.objet_auteur||'').trim()){\n  return [{json:{ok:false,action,chat_id,telegram_message:'❌ La fiche '+cle+' n’a pas d’invitation rédigée : impossible de la valider. Statut actuel : '+String(row.statut||'')+'.'}}];\n}\n\nlet email='';let source='';\nif(action==='email'){\n  email=String(req.email||'').trim().toLowerCase();\n  const c=candidats.find(x=>x&&String(x.email||'').toLowerCase()===email);\n  if(c&&/^https:\\/\\//.test(String(c.source||'')))source=String(c.source);\n}else{\n  const best=candidats.find(x=>x&&x.email&&!publicDomains.has(String(x.email).split('@')[1]||''))||candidats.find(x=>x&&x.email);\n  if(!best){\n    return [{json:{ok:false,action,chat_id,telegram_message:'❌ Aucun email candidat pour '+cle+'.\\nRéponds : /email '+cle+' adresse@retiree.invalid'}}];\n  }\n  email=String(best.email).trim().toLowerCase();\n  if(/^https:\\/\\//.test(String(best.source||'')))source=String(best.source);\n}\nif(!/^\\S+@\\S+\\.\\S+$/.test(email)){\n  return [{json:{ok:false,action,chat_id,telegram_message:'❌ Adresse invalide : '+email}}];\n}\nif(!source)source=/^https:\\/\\//.test(String(row.source_livre||''))?String(row.source_livre):'https://validation.telegram.impacteur/'+encodeURIComponent(cle);\nconst domaine=email.split('@')[1]||'';\nconst exception=publicDomains.has(domaine);\nreturn [{json:{...row,ok:true,action,chat_id,\n  email_contact:email,type_contact:'auteur',source_contact_validee:source,\n  statut:'APPROUVE',validation_contact:exception?'OUI_EXCEPTION':'OUI',\n  derniere_mise_a_jour:new Date().toISOString(),\n  telegram_message:'✅ Fiche '+cle+' approuvée ('+String(row.auteur||'')+').\\n✉️ '+email+(exception?' (domaine grand public : validé en exception)':'')+'\\n📨 Création du brouillon Gmail '+String(row.chaine||'')+' en cours…'}}];"
      },
      "position": [
        208,
        208
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2

    {
      "id": "2fb47f4e-bceb-4b10-88eb-116ad219d691",
      "name": "FILTRER APPROUVES",
      "parameters": {
        "jsCode": "const FOOTER=\"Pour vous donner une idée du format, voici un exemple d’interview que j’ai réalisée sur ma chaîne consacrée à l’Afrique :\\n\\nhttps://www.youtube.com/watch?v=z9B8b6ZrCb4\";\n// Brouillons pour les fiches APPROUVE + OUI. L'approbation humaine fait foi.\nconst lignes=$input.all().map(i=>i.json);\nconst _cfgRow=lignes.find(r=>String(r.cle_unique||'').trim()==='_config_telegram');\nconst chat_id=_cfgRow?String(_cfgRow.informations_a_verifier||'').trim():'';\nconst publicDomains=new Set(['gmail.com','hotmail.com','outlook.com','yahoo.com','proton.me','icloud.com','live.com']);\nconst dejaEmails=new Set(lignes.filter(r=>['NE_PAS_CONTACTER','REFUSE','OPPOSITION']\n .includes(String(r.statut||'').trim().toUpperCase()))\n .map(r=>String(r.email_contact||'').trim().toLowerCase()).filter(Boolean));\nconst sortie=[];\nfor(const r of lignes){\n if(sortie.length>=5)break;\n const statut=String(r.statut||'').trim().toUpperCase();\n const validation=String(r.validation_contact||'').trim().toUpperCase();\n const email=String(r.email_contact||'').trim().toLowerCase();\n const type=String(r.type_contact||'').trim().toLowerCase();\n if(statut!=='APPROUVE')continue;\n if(validation!=='OUI'&&validation!=='OUI_EXCEPTION')continue;\n if(String(r.draft_id||'').trim())continue;\n if(!/^\\S+@\\S+\\.\\S+$/.test(email))continue;\n if(dejaEmails.has(email))continue;\n if(publicDomains.has(email.split('@')[1]||'')&&validation!=='OUI_EXCEPTION')continue;\n if(!['Impacteur Afrique','Impacteur Frexit'].includes(String(r.chaine||'').trim()))continue;\n const estEditeur=['editeur','presse_generique','service_presse'].includes(type);\n const objet=String(r[estEditeur?'objet_editeur':'objet_auteur']||'').trim();\n const message=String(r[estEditeur?'message_editeur':'message_auteur']||'').trim();\n if(!objet||!message||!r.cle_unique)continue;\n if(!message.includes(FOOTER)||!message.endsWith('Cordialement,\\nWalid\\n'+String(r.chaine).trim()))continue;\n sortie.push({json:{cle_unique:String(r.cle_unique),email_contact:email,\n  chaine:String(r.chaine).trim(),objet,message,auteur:String(r.auteur||''),chat_id},pairedItem:{item:0}});\n}\nreturn sortie;"
      },
      "position": [
        400,
        96
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },

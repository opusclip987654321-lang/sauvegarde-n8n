      "parameters": {
        "jsCode": "return $input.all().map((item,i)=>{\n const original=$('FILTRER APPROUVES').itemMatching(i).json;\n const id=String(item.json.id||'').trim();\n if(!id||!original.cle_unique)throw new Error('Identifiant brouillon ou fiche manquant.');\n return {json:{cle_unique:original.cle_unique,statut:'BROUILLON_CREE',draft_id:id,\n  derniere_mise_a_jour:new Date().toISOString(),\n  chat_id:String(original.chat_id||''),\n  telegram_message:'📨 Brouillon Gmail créé — '+String(original.auteur||'')+' ('+String(original.chaine||'')+')\\n✉️ '+String(original.email_contact||'')},\n  pairedItem:{item:i}};\n});"

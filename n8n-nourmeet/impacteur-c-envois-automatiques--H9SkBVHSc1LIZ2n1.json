    {
      "id": "db6e7303-ba19-42c0-a081-cf8e8da4d219",
      "name": "SELECTIONNER ENVOIS",
      "parameters": {
        "jsCode": "const FOOTER=\"Pour vous donner une idée du format, voici un exemple d’interview que j’ai réalisée sur ma chaîne consacrée à l’Afrique :\\n\\nhttps://www.youtube.com/watch?v=z9B8b6ZrCb4\";\n// ENVOI AUTOMATIQUE (décision de Louis, 25-28/09) : toute fiche A_VERIFIER avec\n// invitation conforme et un email candidat part sans validation. Plafond 5/jour.\nconst TRACKING_URL='https://n8n.nourmeet.com/webhook/impacteur-ouverture';\nconst PLAFOND_JOUR=5;\nconst lignes=$input.all().map(i=>i.json);\nconst _cfgRow=lignes.find(r=>String(r.cle_unique||'').trim()==='_config_telegram');\nconst chat_id=_cfgRow?String(_cfgRow.informations_a_verifier||'').trim():'';\nconst norm=s=>String(s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().trim();\nconst jourParis=t=>new Date(t).toLocaleDateString('fr-CA',{timeZone:'Europe/Paris'});\nconst publicDomains=new Set(['gmail.com','hotmail.com','outlook.com','yahoo.com','proton.me','icloud.com','live.com']);\nconst aujourdhui=jourParis(Date.now());\nconst envoyesAujourdhui=lignes.filter(r=>String(r.date_envoi||'').trim()&&jourParis(r.date_envoi)===aujourdhui).length;\nlet budget=PLAFOND_JOUR-envoyesAujourdhui;\nif(budget<=0)return [];\nconst emailsInterdits=new Set(lignes.filter(r=>['NE_PAS_CONTACTER','REFUSE','OPPOSITION']\n .includes(String(r.statut||'').trim().toUpperCase()))\n .map(r=>String(r.email_contact||'').trim().toLowerCase()).filter(Boolean));\nconst emailsDejaServis=new Set(lignes.filter(r=>String(r.date_envoi||'').trim()||String(r.draft_id||'').trim())\n .map(r=>String(r.email_contact||'').trim().toLowerCase()).filter(Boolean));\nconst auteursDejaServis=new Set(lignes.filter(r=>String(r.date_envoi||'').trim()||String(r.draft_id||'').trim())\n .map(r=>norm(r.auteur)).filter(Boolean));\nconst esc=s=>String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst sortie=[];\nconst retenus=[];\nfor(const r of lignes){\n if(budget<=0)break;\n if(String(r.statut||'').trim().toUpperCase()!=='A_VERIFIER')continue;\n if(String(r.draft_id||'').trim()||String(r.date_envoi||'').trim())continue;\n if(!['Impacteur Afrique','Impacteur Frexit'].includes(String(r.chaine||'').trim()))continue;\n const objet=String(r.objet_auteur||'').trim();\n const message=String(r.message_auteur||'').trim();\n if(!objet||!message||!r.cle_unique)continue;\n if(!message.includes(FOOTER)||!message.endsWith('Cordialement,\\nWalid\\n'+String(r.chaine).trim())){retenus.push('👤 '+esc(String(r.auteur||'?'))+' ('+esc(String(r.chaine||'?'))+') — /valider '+String(r.cle_unique||''));continue;}\n if(auteursDejaServis.has(norm(r.auteur)))continue;\n let candidats=[];try{candidats=JSON.parse(String(r.emails_candidats||'[]'));}catch(e){candidats=[];}\n if(!Array.isArray(candidats))candidats=[];\n const best=candidats.find(x=>x&&x.email&&!publicDomains.has(String(x.email).split('@')[1]||''))||candidats.find(x=>x&&x.email);\n if(!best)continue; // pas d'email -> reste en validation manuelle (/email via Telegram)\n const email=String(best.email).trim().toLowerCase();\n if(!/^\\S+@\\S+\\.\\S+$/.test(email)||emailsInterdits.has(email)||emailsDejaServis.has(email))continue;\n const pixel='<img src=\"'+TRACKING_URL+'?c='+encodeURIComponent(String(r.cle_unique))+'\" width=\"1\" height=\"1\" alt=\"\">';\n const message_html='<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#111\">'\n   +esc(message).replace(/\\n/g,'<br>')+'</div>'+pixel;\n emailsDejaServis.add(email);auteursDejaServis.add(norm(r.auteur));\n sortie.push({json:{\n  cle_unique:String(r.cle_unique),auteur:String(r.auteur||''),livre:String(r.livre||''),\n  chaine:String(r.chaine).trim(),email_contact:email,objet,message_html,\n  source_contact_validee:/^https:\\/\\//.test(String(best.source||''))?String(best.source):String(r.source_livre||''),\n  chat_id\n },pairedItem:{item:0}});\n budget--;\n}\nif(retenus.length&&chat_id)sortie.push({json:{retenu:true,chat_id,telegram_message:'⚠️ '+retenus.length+' invitation(s) retenue(s) avant envoi : le texte ne correspond pas au modèle de la chaîne (signature ou exemple). Rien n\\'est parti.\\n'+retenus.join('\\n')+'\\n\\nCorrige la fiche dans le Sheet, ou /valider CLE pour créer un brouillon à envoyer toi-même.'},pairedItem:{item:0}});\nreturn sortie;"
      },
      "position": [
        1232,
        1152
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },

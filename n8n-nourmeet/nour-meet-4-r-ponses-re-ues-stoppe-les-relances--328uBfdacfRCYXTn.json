    {
      "id": "b03b21d7-c7f4-4c8c-aab7-d0a4eaacad92",
      "name": "Analyser la réponse",
      "parameters": {
        "jsCode": "// Les mails restent NON LUS : Walid les lit lui-même dans sa messagerie.\nconst out = [];\nfor (const { json: m } of $input.all()) {\n  const from = String(m.from || '');\n  const adr = ((from.match(/<([^>]+)>/) || [])[1] || from).trim().toLowerCase();\n  const sujet = String(m.subject || ''); const corps = String(m.textPlain || m.text || '');\n  if (/réponse automatique|reponse automatique|automatic reply|auto[- ]?reply|absent|out of office|congés/i.test(sujet)) continue;\n  if (/mailer-daemon|postmaster/i.test(adr)) {\n    // Retour en erreur : on retrouve l'adresse qui a échoué dans le texte\n    const cible = (corps.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi) || [])\n      .map(e => e.toLowerCase()).find(e => !e.endsWith('@nourmeet.com') && !/mailer-daemon|postmaster/.test(e));\n    if (cible) out.push({ json: { email: cible, motif: 'adresse_invalide' } });\n    continue;\n  }\n  // On ne lit que le texte écrit par le restaurant : le mail cité contient lui-même « répondez STOP »,\n  // ce qui transformait n'importe quelle réponse courte en refus.\n  const propre = corps.split(/\\r?\\n(?:>|Le .{0,120}a écrit|On .{0,120}wrote|De ?:|From ?:|Envoyé ?:|-{2,} ?(?:Original|Message d'origine)|_{5,})/i)[0];\n  const refus = /\\bstop\\b|désinscri|desinscri|d[ée]sabonn|unsubscribe|ne (plus|pas) (me |nous )?(contacter|écrire|ecrire|solliciter|relancer)|ne plus recevoir|pas intéress|pas interess|aucun intérêt|retirez|supprimez (mon|notre|nos)/i.test(propre.slice(0, 1500) + ' ' + sujet);\n  out.push({ json: { email: adr, motif: refus ? 'refus' : 'reponse' } });\n}\nreturn out;"
      },
      "position": [
        -448,
        160
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },

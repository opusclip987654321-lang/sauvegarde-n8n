      "name": "MARQUER OUVERTURE",
      "parameters": {
        "jsCode": "// Marque la première ouverture d'un email envoyé (pixel de suivi).\nlet cle='';\ntry{cle=String($('PIXEL - ouverture').first().json.query?.c||'').trim();}catch(e){}\nif(!cle)return [];\nconst lignes=$input.all().map(i=>i.json);\nconst row=lignes.find(r=>String(r.cle_unique||'').trim()===cle);\nif(!row)return [];                       // clé inconnue : on ignore (pas de ligne créée)\nif(!String(row.date_envoi||'').trim())return []; // jamais envoyé : on ignore\nif(String(row.ouvert_le||'').trim())return [];   // déjà marqué ouvert\nreturn [{json:{cle_unique:cle,ouvert_le:new Date().toISOString()}}];"
      },

        "jsCode": "// ====== À REMPLIR UNE FOIS ======\nconst CONFIG = {\n  TELEGRAM_CHAT_ID: '6339897621',            // ton identifiant de chat Telegram (via @userinfobot)\n  EXPEDITEUR: 'Nūr Meet <contact@nourmeet.com>',\n  SIGNATAIRE: 'Walid',\n  LIEN_CANDIDATURE: 'https://nourmeet.com/login',\n  PROPOSITIONS_PAR_JOUR: 50,\n  RELANCE_1_APRES_JOURS: 4,                 // J+4 (à confirmer)\n  RELANCE_2_APRES_JOURS: 9,                 // J+9 (à confirmer)\n};\n\nconst cq = $json.callback_query || {};\nconst [action, id] = String(cq.data || '').split(':');\nreturn { json: {\n  ...CONFIG,\n  autorise: String(cq.from?.id) === String(CONFIG.TELEGRAM_CHAT_ID) && ['S', 'R'].includes(action) && !!id,\n  action, envoi_id: Number(id), query_id: cq.id,\n  chat_id: cq.message?.chat?.id, message_id: cq.message?.message_id, texte: cq.message?.text || '',\n}};"

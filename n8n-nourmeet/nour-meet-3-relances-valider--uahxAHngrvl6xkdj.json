    {
      "id": "36c88ebe-b474-4cc0-bbc2-e4517ef2ee9b",
      "name": "Qui relancer aujourd'hui ?",
      "parameters": {
        "jsCode": "function phraseAccroche(p) {\n  const faits = [];\n  if (p.sans_alcool === 'confirmé (site)') faits.push('votre offre de boissons sans alcool');\n  if (p.privatisation === 'confirmé (site)') faits.push('la possibilité de privatiser vos espaces');\n  const lieu = p.ville ? `${p.nom} à ${p.ville}` : p.nom;\n  if (faits.length) return `En découvrant ${lieu}, et notamment ${faits.join(' et ')}, nous avons pensé que vous pourriez accueillir ce type de soirée.`;\n  return `En découvrant ${lieu}, nous avons pensé que votre établissement pourrait accueillir ce type de soirée.`;\n}\nconst PIED = (C) => `Bien cordialement,\\n${C.SIGNATAIRE}\\nNūr Meet\\ncontact@nourmeet.com\\n\\nSi vous ne souhaitez plus recevoir de message de notre part, répondez simplement « STOP ».`;\n\nfunction mailInitial(p, C) {\n  return {\n    objet: `${p.nom} : proposer vos soirées rencontre et networking sur Nūr Meet`,\n    corps:\n`Bonjour,\n\nJe vous écris au nom de Nūr Meet, une plateforme qui publie des soirées de rencontre et de networking organisées dans des restaurants d'Île-de-France.\n\n${phraseAccroche(p)}\n\nLe principe est simple :\n- vous proposez vos propres soirées payantes, de rencontre ou de networking, et publiez l'annonce sur Nūr Meet ;\n- vous restez l'organisateur de la soirée dans votre établissement ;\n- notre équipe valide chaque annonce avant sa publication.\n\nPour candidater, il suffit de créer votre compte ici : ${C.LIEN_CANDIDATURE}\n\nJe reste disponible pour répondre à vos questions par simple retour de mail.\n\n${PIED(C)}`,\n  };\n}\n\nfunction mailRelance(p, n, C) {\n  if (n === 1) return {\n    objet: `Nūr Meet : vos soirées chez ${p.nom} ?`,\n    corps:\n`Bonjour,\n\nJe me permets de revenir vers vous au sujet de Nūr Meet. Si l'idée d'organiser des soirées de rencontre ou de networking chez ${p.nom} vous intéresse, la candidature se fait en quelques minutes : ${C.LIEN_CANDIDATURE}\n\nNous validons chaque annonce avant publication, et vous restez l'organisateur de vos soirées.\n\n${PIED(C)}`,\n  };\n  return {\n    objet: `Dernier message : Nūr Meet et ${p.nom}`,\n    corps:\n`Bonjour,\n\nJe vous adresse un dernier message au sujet de Nūr Meet. Si ce n'est pas le bon moment, aucun souci, je ne vous relancerai plus.\n\nSi l'idée vous tente plus tard, vous pourrez toujours candidater ici : ${C.LIEN_CANDIDATURE}\n\n${PIED(C)}`,\n  };\n}\n\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst C = $('Configuration').first().json;\nconst exclus = new Set($('Lire les exclusions').all().map(i => i.json.email).filter(Boolean));\nconst enAttente = new Set($('Lire les propositions en attente').all().map(i => i.json.prospect_place_id).filter(Boolean));\nconst jours = (d) => (Date.now() - new Date(d).getTime()) / 86400000;\nconst out = [];\nfor (const { json: p } of $input.all()) {\n  if (!p.place_id || !p.date_premier_envoi || exclus.has(p.email) || enAttente.has(p.place_id)) continue;\n  let n = 0;\n  if (p.statut === 'contacte' && jours(p.date_premier_envoi) >= C.RELANCE_1_APRES_JOURS) n = 1;\n  if (p.statut === 'relance1' && jours(p.date_premier_envoi) >= C.RELANCE_2_APRES_JOURS) n = 2;\n  if (!n) continue;\n  const m = mailRelance(p, n, C);\n  out.push({ json: {\n    ligne: { prospect_place_id: p.place_id, nom: p.nom, email: p.email, type: 'relance' + n, objet: m.objet,\n             corps: m.corps, statut: 'en_attente', date_proposition: new Date().toISOString() },\n    telegram_text:\n`<b>🔁 Relance ${n} : ${esc(p.nom)}</b>\n✉️ ${esc(p.email)}  ·  1er mail le ${new Date(p.date_premier_envoi).toLocaleDateString('fr-FR')}\n🌐 ${esc(p.site || '')}\n\n<b>Objet :</b> ${esc(m.objet)}\n<blockquote expandable>${esc(m.corps)}</blockquote>`,\n  }});\n}\nreturn out;"
      },

      "parameters": {
        "jsCode": "\nconst q = $input.first().json.callback_query;\nif (!q || String(q.from.id) !== '6339897621') return [];\nconst [action, vid, a, b] = (q.data || '').split('|');\nconst now = new Date().toISOString();\nconst F = (col, val) => ({ type: 'and', filters: [{ columnName: col, condition: 'eq', value: val }] });\nconst R = {\n  ok:         { label: '✅ Retenu — je prépare l\\'extrait', data: { decision: 'interessant', decision_le: now, statut: 'en_production' }, hook: { path: 'prod-extrait-5b7e', body: { video_id: vid } } },\n  no:         { label: '❌ Rejeté', data: { decision: 'pas_interessant', decision_le: now, statut: 'traitee' } },\n  src:        { label: '🚫 Source ignorée', data: { decision: 'source_ignoree', decision_le: now, statut: 'traitee' }, source: a },\n  clip_ok:    { label: '✅ Extrait validé — je te l\\'envoie pour TikTok', data: { statut: 'extrait_valide' }, hook: { path: 'publication-9a1c', body: { video_id: vid } } },\n  clip_retry: { label: '🔁 Je cherche un autre moment…', data: { statut: 'en_production' }, hook: { path: 'prod-extrait-5b7e', body: { video_id: vid, exclure: [+a, +b] } } },\n  clip_no:    { label: '🗑 Extrait abandonné', data: { statut: 'abandonnee' } },\n}[action];\nif (!R) return [];\nconst veille = ['ok', 'no', 'src'].includes(action);\nreturn [{ json: { query_id: q.id, chat_id: q.message.chat.id, message_id: q.message.message_id, label: R.label, action, video_id: vid,\n  veille, texte: (q.message.text || '') + `\\n\\n<b>${R.label}</b>`,\n  maj_video: { filter: F('video_id', vid), data: R.data },\n  maj_source: R.source ? { filter: F('channel_id', R.source), data: { statut: 'ignored' } } : null,\n  hook: R.hook || null } }];\n"

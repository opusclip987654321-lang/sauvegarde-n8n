      "name": "À relever",
      "parameters": {
        "jsCode": "\n// Relevés des réactions : J+3 (72 h) et J+7 (168 h) après publication. Tout est enregistré (phase d'exploration, 200 Shorts).\nconst now = Date.now(); const out = [];\nlet force = false; try { force = $('Lancement manuel').first().json.query.force === '1'; } catch (e) {}\nfor (const r of ($input.first().json.data || []).filter(r => r.compte === 'afrique')) { // Impacteur Afrique uniquement\n  const age = (now - Date.parse(r.publiee_le)) / 3600e3; if (!(age > 0)) continue;\n  let releve = null;\n  if (age >= 168 && !r.releve_j7) releve = 'J7';\n  else if (age >= 72 && age < 168 && !r.releve_j3) releve = 'J3';\n  else if (force && age < 72) releve = 'test';\n  if (!releve) continue;\n  out.push({ json: { row_id: r.id, pub_id: r.pub_id, video_id: r.video_id, yt_id: r.yt_id || '', fb_id: r.fb_id || '', ig_id: r.ig_id || '',\n    publiee_le: r.publiee_le, releve, age_h: Math.round(age), manque_j3: releve === 'J7' && !r.releve_j3 } });\n}\nreturn out;\n"
      },

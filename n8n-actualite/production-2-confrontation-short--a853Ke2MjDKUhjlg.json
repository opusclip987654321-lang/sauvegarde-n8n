    {
      "id": "1acf7d81-42a8-4c08-ae2b-de5aa9df4e33",
      "name": "Choix des extraits",
      "parameters": {
        "jsCode": "\nconst p = $('Partenaire').first().json, d = $('Préparer le montage').first().json;\nconst txt = ($input.first().json.content || []).map(x => x.text || '').join('');\nlet c; try { c = JSON.parse(txt.slice(txt.indexOf('{'), txt.lastIndexOf('}') + 1)); } catch (e) { throw new Error('Montage Claude illisible : ' + txt.slice(0, 200)); }\nif (c.aucun) return [{ json: { aucun: true } }];\nconst seg = (k, v, dur) => { let s = Math.max(0, +c[k].start), e = Math.min(+c[k].end, dur || +c[k].end); if (!(e > s)) throw new Error('Intervalle invalide ' + k); if (e - s > 80) e = s + 75; return { video_id: v.video_id, start: s, end: e, titre: c.titre, source: v.source_nom }; };\nconst map = { A: seg('A', p.A, d.dA), B: seg('B', p.B, d.dB) };\nconst ordre = (c.ordre || ['A', 'B']).filter(k => map[k]); const segments = (ordre.length === 2 ? ordre : ['A', 'B']).map(k => map[k]);\nconst sources = segments.map(s => s.source).join(' + ');\nconst duree = Math.round(segments.reduce((t, s) => t + s.end - s.start, 0));\nconst analyse = { ...(c.analyse || {}), format: 'confrontation', chaine: sources, duree_s: duree, videos: segments.map(s => s.video_id) };\nreturn [{ json: { aucun: false, segments, sources, duree, titre: c.titre, description: c.description, raison: c.raison, analyse, A: p.A } }];\n"
      },
      "position": [
        3300,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },

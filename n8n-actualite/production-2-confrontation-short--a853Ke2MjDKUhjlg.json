    {
      "id": "5709bfc9-eb92-4c4f-878a-40c5de3479f8",
      "name": "Candidats partenaires",
      "parameters": {
        "jsCode": "\nconst A = ($('Lire la vidéo A').first().json.data || [])[0];\nif (!A) throw new Error('Vidéo inconnue : ' + JSON.stringify($('Demande').first().json.body));\nconst src = Object.fromEntries(($('Lire sources').first().json.data || []).map(s => [s.channel_id, s.statut]));\nif (src[A.channel_id] && src[A.channel_id] !== 'usable') throw new Error(`${A.source_nom} n'est plus utilisable (liste noire) : pas d'extrait.`);\nconst now = Date.now();\nconst vus = new Set();\nconst cands = ($('Lire historique').first().json.data || []).filter(r => {\n  if (r.video_id === A.video_id || vus.has(r.video_id)) return false; vus.add(r.video_id);\n  return r.compte !== 'afrique' && src[r.channel_id] === 'usable' && (r.duree_s || 0) >= 20 && r.statut !== 'abandonnee' && now - Date.parse(r.publiee_le || 0) < 48 * 3600e3;\n}).slice(0, 60);\nconst fiche = r => ({ video_id: r.video_id, source: r.source_nom, titre: r.titre, personnes: r.personnes, camp: r.camp, theme: r.theme, angle: r.angle });\nconst system = `Tu es rédacteur en chef d'« L’Extrait politique ». On veut monter un Short au format CONFRONTATION : deux extraits de deux vidéos DIFFÉRENTES qui se répondent (contradiction, promesse vs réalité, camp contre camp, politique contre expert, deux lectures opposées d'un même fait).\nOn te donne la vidéo principale et une liste de vidéos récentes. Choisis LA vidéo partenaire qui répond le mieux à la principale : même sujet ou même événement, intervenant différent, idéalement point de vue opposé. Si aucune ne parle vraiment du même sujet, réponds \"aucun\" : ne force jamais un rapprochement artificiel.\nRéponds UNIQUEMENT en JSON : {\"partenaire\": \"video_id ou aucun\", \"raison\": \"15 mots max\"}`;\nconst user = JSON.stringify({ principale: fiche(A), candidates: cands.map(fiche) });\nreturn [{ json: { A, cands, ok: cands.length > 0, body: { model: 'claude-sonnet-4-5', max_tokens: 400, system, messages: [{ role: 'user', content: user }] } } }];\n"
      },
      "position": [
        1100,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },

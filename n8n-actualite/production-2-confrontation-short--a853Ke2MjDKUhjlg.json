      "parameters": {
        "jsCode": "\nconst c = $('Candidats partenaires').first().json;\nconst txt = ($input.first().json.content || []).map(x => x.text || '').join('');\nlet r = {}; try { r = JSON.parse(txt.slice(txt.indexOf('{'), txt.lastIndexOf('}') + 1)); } catch (e) {}\nconst B = c.cands.find(x => x.video_id === r.partenaire);\nreturn [{ json: { trouve: !!B, A: c.A, B: B || null, raison: r.raison || '' } }];\n"

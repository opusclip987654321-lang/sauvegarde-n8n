    {
      "id": "u16",
      "name": "Récapitulatif",
      "parameters": {
        "jsCode": "\nconst esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst get = n => { try { return $(n).first().json; } catch (e) { return null; } };\nconst v = $('Préparer').first().json;\nconst pauses = get('Pauses plateformes') || {};\nconst RAISONS = { meta_app_bloquee: 'Meta bloque l’app', meta_jeton: 'jeton Meta expiré', meta_limite: 'limite Meta', yt_limite_envois: 'limite d’envois YouTube atteinte',\n  yt_quota: 'quota YouTube épuisé', yt_auth: 'connexion YouTube perdue' };\nconst court = m => { const s = String(m || 'échec');\n  if (/Cannot call API for app|API access blocked/i.test(s)) return 'Meta bloque l’app';\n  if (/uploadLimitExceeded|exceeded the number of videos/i.test(s)) return 'limite d’envois YouTube atteinte';\n  const j = s.match(/\"message\"\\s*:\\s*\"([^\"]{1,160})/); return (j ? j[1] : s).slice(0, 160); };\nconst ev = [], titre = v.titre_short || v.titre || 'Extrait', video = { id: v.video_id, titre };\nconst W = 'PUBLICATION AFRIQUE';\n// ---- YouTube ----\nlet yt = get('Publier sur YouTube') || {}, ytLigne, ytStatut;\nif (pauses.yt_pause) { ytStatut = 'en_pause'; ytLigne = `⏸️ YouTube : en pause jusqu'à ${pauses.yt_pause.hh} (${esc(RAISONS[pauses.yt_pause.raison] || 'échecs répétés')}) — Short à mettre en ligne plus tard`;\n  ev.push({ type: 'saute', plateforme: 'youtube', workflow: W, noeud: 'Publier sur YouTube', video }); }\nelse if (yt.uploadId) { ytStatut = 'public'; ytLigne = `✅ YouTube : https://youtube.com/shorts/${yt.uploadId}`;\n  ev.push({ type: 'retabli', plateforme: 'youtube', workflow: W, video }); }\nelse { ytStatut = 'echec';\n  const d = get('YouTube - détail de l\\'erreur'); const corps = d && d.body ? JSON.stringify(d.body) : '';\n  const brut = [(yt.error && (yt.error.message || JSON.stringify(yt.error))) || 'échec sans message', corps ? 'Réponse complète de YouTube (même demande rejouée) : ' + corps : '',\n    d && d.statusCode && d.statusCode < 300 ? '(La demande rejouée a été acceptée : erreur probablement passagère.)' : ''].filter(Boolean).join('\\n');\n  ytLigne = `❌ YouTube : ${esc(court(corps || brut))}`;\n  ev.push({ type: 'echec', plateforme: 'youtube', workflow: W, noeud: 'Publier sur YouTube', video, brut, exec_id: String($execution.id) }); }\n// ---- Facebook / Instagram ----\nlet fb = get('Publier sur Facebook'), ig = get('Lien Instagram') || {}, fbLigne, igLigne, fbOk = false;\nif (pauses.meta_pause) {\n  fbLigne = igLigne = null;\n  ev.push({ type: 'saute', plateforme: 'meta', workflow: W, noeud: 'Publier sur Facebook', video });\n} else {\n  fb = fb || {}; fbOk = !!fb.id && !fb.error;\n  let igErr = ''; try { const s = $('Statut Instagram').last().json; if (s.status_code && s.status_code !== 'FINISHED') igErr = JSON.stringify(s); } catch (e) {}\n  const c = get('Créer le Reel Instagram'); if (c && c.error) igErr = c.error.message || JSON.stringify(c.error);\n  const pub = get('Publier sur Instagram'); if (!ig.permalink && pub && pub.error) igErr = pub.error.message || JSON.stringify(pub.error);\n  const fbErr = fb.error ? (fb.error.message || JSON.stringify(fb.error)) : (fbOk ? '' : 'échec sans message');\n  fbLigne = fbOk ? `✅ Facebook : https://www.facebook.com/${fb.id}` : `❌ Facebook : ${esc(court(fbErr))}`;\n  igLigne = ig.permalink ? `✅ Instagram : ${ig.permalink}` : `❌ Instagram : ${esc(court(igErr || 'échec'))}`;\n  const metaGlobal = /OAuthException|Cannot call API|API access blocked|\"code\"\\s*:\\s*(190|200|4|17|32|613)\\b/;\n  const ailleurs = [ytStatut === 'public' ? 'YouTube' : null].filter(Boolean);\n  if (!fbOk && !ig.permalink && metaGlobal.test(fbErr) && metaGlobal.test(igErr || '')) {\n    ev.push({ type: 'echec', plateforme: 'meta', workflow: W, noeud: 'Publier sur Facebook + Créer le Reel Instagram', video, exec_id: String($execution.id),\n      impact: `« ${titre} » n'est publié ni sur Facebook ni sur Instagram.` + (ailleurs.length ? ` Il est bien sur ${ailleurs.join(', ')}.` : ' Il n’est publié nulle part (hors TikTok manuel).'),\n      brut: 'Facebook : ' + fbErr + '\\nInstagram : ' + igErr });\n  } else {\n    if (fbOk) ev.push({ type: 'retabli', plateforme: 'meta', workflow: W, video }); // Meta répond à nouveau\n    else ev.push({ type: 'echec', plateforme: metaGlobal.test(fbErr) ? 'meta' : 'facebook', workflow: W, noeud: 'Publier sur Facebook', video, brut: fbErr, exec_id: String($execution.id),\n      impact: `« ${titre} » n'est pas publié sur Facebook.` });\n    if (!ig.permalink) ev.push({ type: 'echec', plateforme: metaGlobal.test(igErr) ? 'meta' : 'instagram', workflow: W, noeud: 'Créer le Reel Instagram', video, brut: igErr || 'échec sans message',\n      exec_id: String($execution.id), impact: `« ${titre} » n'est pas publié sur Instagram.` });\n  }\n}\nif (pauses.meta_pause) fbLigne = `⏸️ Facebook + Instagram : en pause jusqu'à ${pauses.meta_pause.hh} (${esc(RAISONS[pauses.meta_pause.raison] || 'échecs répétés')}) — Short à reprendre plus tard`;\nconst lignes = [`🌍 <b>Impacteur Afrique</b>\\n🚀 <b>${esc(titre)}</b>`, fbLigne, igLigne, ytLigne, `📲 TikTok : à publier à la main (vidéo ci-dessus)`].filter(Boolean);\nreturn [{ json: { texte: lignes.join('\\n'), fb_ok: fbOk, ig_ok: !!ig.permalink, video_id: v.video_id, evenements: ev,\n  pub_row: { data: [{ compte: 'afrique', pub_id: 'shortafr_' + v.video_id + '_' + Date.now(), type: 'short', publiee_le: new Date().toISOString(), titre: v.titre_short || v.titre,\n    yt_id: yt.uploadId || '', fb_id: (fb && fb.id) || '', ig_id: (ig.id || ''), sources: JSON.stringify(v.sources_clip ? v.sources_clip.split(' + ') : [v.source_nom]),\n    segments: JSON.stringify({ segments: [{ titre: v.titre_short, source: v.source_nom, video_id: v.video_id, personnes: v.personnes, camp: v.camp, theme: v.theme, type_moment: v.type_moment }] }),\n    duree_s: (() => { try { const d = JSON.parse(v.analyse_short || '{}').duree_s; if (d) return d; } catch (e) {} return Math.round((v.extrait_fin || 0) - (v.extrait_debut || 0)); })(), heure: new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' }),\n    statut_yt: ytStatut, alerte: ev.filter(e => e.type !== 'retabli').map(e => e.plateforme + ':' + e.type).join(',') }] } } }];\n"
      },

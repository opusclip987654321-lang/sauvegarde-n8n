      "name": "Préparer",
      "parameters": {
        "jsCode": "\nconst v = ($input.first().json.data || [])[0];\nif (!v) throw new Error('Vidéo inconnue');\n// anti-doublon : seule l'exécution qui a réservé le créneau en dernier publie\nif (v.statut === 'publiee' || v.statut === 'abandonnee' || (v.pub_exec && v.pub_exec !== String($execution.id))) return [];\nif (v.extrait_debut == null) throw new Error('Pas d\\'extrait monté pour cette vidéo');\nconst fichier = v.fichier_clip || `${v.video_id}_${Math.floor(v.extrait_debut)}_${Math.floor(v.extrait_fin)}_v.mp4`;\nconst srcs = v.sources_clip || v.source_nom;\nconst esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst mention = /s[ée]nat/i.test(srcs || '') ? '\\nImages fournies par le Sénat français.' : (/assembl[ée]e nationale/i.test(srcs || '') ? '\\nImages : Assemblée nationale.' : '');\nconst legende = `${v.titre_short || ''}\\n\\n${v.description_yt || ''}\\n\\n📺 ${v.sources_clip ? 'Sources' : 'Source'} : ${srcs}${mention}`.trim();\nreturn [{ json: { ...v, fichier, legende,\n  caption: `📲 <b>🌍 À publier sur TikTok Impacteur Afrique</b>\\n\\n1. Enregistre la vidéo (appui long → Enregistrer)\\n2. Dans TikTok : + → choisis la vidéo → ajoute un son tendance si tu veux\\n3. Colle ce texte en légende (appuie dessus pour le copier) :\\n\\n<code>${esc(legende.slice(0, 520))}</code>\\n\\n⏳ Publication Impacteur Afrique (YouTube + Facebook + Instagram) en cours…`.slice(0, 860) } }];\n"
      },

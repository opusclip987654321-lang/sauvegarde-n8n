      "id": "u2d",
      "name": "Créneau",
      "parameters": {
        "jsCode": "\nconst v = ($('Lire la vidéo').first().json.data || [])[0];\nif (!v) throw new Error('Vidéo inconnue');\nconst dup = ['planifiee', 'publiee', 'abandonnee'].includes(v.statut);\nconst pubs = ($('Lire publications').first().json.data || []).filter(p => p.type === 'short' && p.compte === 'afrique');\nconst plan = ($('Lire planning').first().json.data || []).filter(r => r.publication_prevue && r.compte === 'afrique' && r.video_id !== v.video_id);\n// Impacteur Afrique : 1 Short toutes les 6 h (4 par jour)\nconst ECART = 6 * 3600e3;\nconst t = [...pubs.map(p => Date.parse(p.publiee_le)), ...plan.map(r => Date.parse(r.publication_prevue))].filter(x => !isNaN(x));\nconst last = t.length ? Math.max(...t) : 0;\nconst slot = new Date(Math.max(Date.now() + 5e3, last + ECART));\nconst hh = slot.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });\nconst immediat = slot.getTime() - Date.now() < 90e3;\nreturn [{ json: { dup, statut: v.statut, slot: slot.toISOString(), hh, immediat, video_id: v.video_id, titre: v.titre_short || v.titre,\n  maj: { filter: { type: 'and', filters: [{ columnName: 'video_id', condition: 'eq', value: v.video_id }] }, data: { statut: 'planifiee', publication_prevue: slot.toISOString(), pub_exec: String($execution.id) } } } }];\n"
      },
